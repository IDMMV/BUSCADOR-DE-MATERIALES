# ==============================================================================
# VARIABLES DE ENTORNO PARA VERCEL (SINCRONIZACIÓN GOOGLE DRIVE / APPS SCRIPT)
# ==============================================================================
# Solo necesitas configurar estas 2 variables en Vercel (Project Settings > Environment Variables):
#
# 1. GOOGLE_APPS_SCRIPT_URL:
#    URL web generada al publicar Code.gs en Google Apps Script (script.google.com).
#    Debe terminar obligatoriamente en /exec.
#    Ejemplo: https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec

# 2. GOOGLE_APPS_SCRIPT_TOKEN:
#    Clave o contraseña secreta que tú mismo inventaste en la variable ACCESS_TOKEN
#    dentro de Code.gs (por ejemplo: MiClaveSegura2025).
GOOGLE_APPS_SCRIPT_TOKEN=TU_CLAVE_SECRETA_AQUI
